{
    "name": "setup-gungraun",
    "license": "MIT",
    "version": "1.1.3",
    "author": {
        "name": "gamma0987",
        "email": "gamma0987@posteo.de"
    },
    "description": "GitHub Action to setup Gungraun and install gungraun-runner and Valgrind",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gungraun/setup-gungraun.git"
    },
    "keywords": [
        "actions",
        "gungraun",
        "valgrind",
        "setup"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "rm -rf .ncc-build && tsc -p tsconfig.build.json --noEmit false --outDir .ncc-build && ncc build .ncc-build/main.js -o dist && rm -rf .ncc-build",
        "build:check": "npm run build && git diff --exit-code --quiet dist/",
        "check": "tsc --noEmit -p tsconfig.build.json",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "lint": "eslint .",
        "prepare": "simple-git-hooks",
        "test": "NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:coverage": "NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
    },
    "simple-git-hooks": {
        "pre-commit": "npm run format:write && npm run lint && npm run build:check",
        "pre-push": "npm run format:write && npm run lint && npm test && npm run build && npm install"
    },
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/exec": "^3.0.0",
        "@actions/github": "^9.1.1",
        "@actions/io": "^3.0.2",
        "@actions/tool-cache": "^4.0.0",
        "shell-quote": "^1.10.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.1",
        "@types/shell-quote": "^1.7.5",
        "@vercel/ncc": "^0.44.1",
        "eslint": "^10.7.0",
        "jest": "^30.0.0",
        "prettier": "^3.9.6",
        "simple-git-hooks": "^2.13.1",
        "ts-jest": "^29.4.12",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.65.0"
    }
}
